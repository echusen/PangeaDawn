# Pangea Dawn C++ formatting. Mirrors .agents/rules/cpp-coding-standards.md
# (Epic coding standard plus project addenda). Requires clang-format 19+.
#
# Scope: Pangea-owned code only (Source/, Plugins/GameFeatures/GF_Pangea*).
# Never format vendor plugins; see AGENTS.md.
#
# This file controls layout only. It never adds braces, renames or reorders
# code, so a formatting pass is always behaviour-neutral.
---
Language: Cpp
Standard: c++20

# --- Indentation (rule 1.1: tabs, four columns wide) -------------------------
UseTab: Always
TabWidth: 4
IndentWidth: 4
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4
AccessModifierOffset: -4
IndentAccessModifiers: false
IndentCaseLabels: true
IndentCaseBlocks: false
IndentGotoLabels: false
IndentPPDirectives: None
IndentExternBlock: NoIndent
IndentWrappedFunctionNames: false
NamespaceIndentation: None
LambdaBodyIndentation: OuterScope

# --- Line length (rule 1.3) --------------------------------------------------
# Wide enough for UE identifiers; long conditions and calls wrap one item per line.
ColumnLimit: 160
ReflowComments: false
BreakStringLiterals: false

# --- Braces (rules 1.4, 12.1: Allman, body always on its own line) -----------
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: true
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true
InsertBraces: false
RemoveBracesLLVM: false

# --- One statement per line (rules 1.2, 12.1) --------------------------------
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: All
AllowShortCompoundRequirementOnASingleLine: true

# --- Vertical spacing --------------------------------------------------------
SeparateDefinitionBlocks: Leave
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtEndOfFile: false
  AtStartOfBlock: false
  AtStartOfFile: false
EmptyLineBeforeAccessModifier: LogicalBlock
EmptyLineAfterAccessModifier: Never
InsertNewlineAtEOF: true
LineEnding: DeriveCRLF

# --- Pointers, references, qualifiers ---------------------------------------
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Pointer
QualifierAlignment: Leave
SpaceAroundPointerQualifiers: Default

# --- Horizontal spacing ------------------------------------------------------
SpaceBeforeParens: ControlStatements
SpaceBeforeAssignmentOperators: true
SpaceBeforeCpp11BracedList: false
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeRangeBasedForLoopColon: true
SpaceBeforeSquareBrackets: false
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: false
SpaceAfterTemplateKeyword: true
SpaceInEmptyBlock: false
SpacesInAngles: Never
SpacesInParens: Never
SpacesInSquareBrackets: false
SpacesBeforeTrailingComments: 1
Cpp11BracedListStyle: false
BitFieldColonSpacing: Both

# --- Alignment (off: alignment with tabs breaks at other tab widths) ---------
AlignAfterOpenBracket: DontAlign
AlignArrayOfStructures: None
AlignConsecutiveAssignments: None
AlignConsecutiveBitFields: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignEscapedNewlines: DontAlign
AlignOperands: DontAlign
AlignTrailingComments:
  Kind: Leave

# --- Breaking ----------------------------------------------------------------
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true
BreakConstructorInitializers: BeforeComma
BreakInheritanceList: BeforeColon
BreakTemplateDeclarations: Yes
BreakAfterAttributes: Leave
PackConstructorInitializers: Never
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
CompactNamespaces: false
FixNamespaceComments: true
ShortNamespaceLines: 0

# --- Includes (rules 3.3 to 3.8) ---------------------------------------------
# Blank-line separated groups are kept as written (own header, engine, project,
# conditional). Inside a group: CoreMinimal.h first, *.generated.h last,
# everything else alphabetical.
SortIncludes: CaseInsensitive
IncludeBlocks: Preserve
IncludeIsMainRegex: '$'
IncludeCategories:
  - Regex: '\.generated\.h"$'
    Priority: 3
  - Regex: '^"CoreMinimal\.h"$'
    Priority: 1
  - Regex: '.*'
    Priority: 2
SortUsingDeclarations: Never

# --- Unreal macros -----------------------------------------------------------
# Reflection and declaration macros that stand alone without a semicolon.
StatementMacros:
  - UDELEGATE
  - UFUNCTION
  - UPROPERTY
  - GENERATED_BODY
  - GENERATED_IINTERFACE_BODY
  - GENERATED_UCLASS_BODY
  - GENERATED_UINTERFACE_BODY
  - GENERATED_USTRUCT_BODY
  - RIGVM_METHOD
  - UE_DEPRECATED
  - DECLARE_DELEGATE
  - DECLARE_MULTICAST_DELEGATE
  - DECLARE_DYNAMIC_DELEGATE
  - DECLARE_DYNAMIC_MULTICAST_DELEGATE
  - DECLARE_EVENT
  - DECLARE_LOG_CATEGORY_EXTERN
  - DEFINE_LOG_CATEGORY
  - DEFINE_LOG_CATEGORY_STATIC
  - IMPLEMENT_MODULE
  - IMPLEMENT_GAME_MODULE
  - IMPLEMENT_PRIMARY_GAME_MODULE
  - IMPLEMENT_SIMPLE_AUTOMATION_TEST
  - IMPLEMENT_COMPLEX_AUTOMATION_TEST
  - IMPLEMENT_CUSTOM_SIMPLE_AUTOMATION_TEST
  - DEFINE_LATENT_AUTOMATION_COMMAND
  - DEFINE_LATENT_AUTOMATION_COMMAND_ONE_PARAMETER
  - DEFINE_LATENT_AUTOMATION_COMMAND_TWO_PARAMETER
  - UE_DEFINE_GAMEPLAY_TAG
  - UE_DEFINE_GAMEPLAY_TAG_COMMENT
  - UE_DEFINE_GAMEPLAY_TAG_STATIC
  - UE_DECLARE_GAMEPLAY_TAG_EXTERN
AttributeMacros:
  - UE_NODISCARD
  - FORCEINLINE
  - FORCENOINLINE
...
